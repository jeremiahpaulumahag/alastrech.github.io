// Character Renderer - draws and animates three personalized characters
export class CharacterRenderer {
    constructor(ctx, width, height) {
        this.ctx = ctx;
        this.width = width;
        this.height = height;
        
        // Character definitions based on reference photos
        this.characters = [
            {
                name: 'Ruby',
                position: 'left',
                x: width * 0.25,
                // Ruby - red cardigan, dark hair pulled back
                hairColor: '#2b1810',
                hairStyle: 'pulled-back',
                skinTone: '#d4a574',
                topColor: '#dc2626', // Red athletic top
                bottomColor: '#1e293b', // Dark athletic pants
                hasGlasses: false,
                bodyShape: 'average',
                height: 1.0
            },
            {
                name: 'Ala',
                position: 'center',
                x: width * 0.5,
                // Ala (Judy Ann) - brown shoulder-length hair, yellow dress reference
                hairColor: '#6b4423',
                hairStyle: 'shoulder-length',
                skinTone: '#d4a574',
                topColor: '#eab308', // Yellow athletic top
                bottomColor: '#334155', // Gray athletic leggings
                hasGlasses: false,
                bodyShape: 'average',
                height: 1.0
            },
            {
                name: 'Tine',
                position: 'right',
                x: width * 0.75,
                // Tine - bride reference, elegant features
                hairColor: '#3d2817',
                hairStyle: 'styled-up',
                skinTone: '#e8c4a0',
                topColor: '#8b5cf6', // Purple athletic top
                bottomColor: '#475569', // Slate athletic leggings
                hasGlasses: false,
                bodyShape: 'average',
                height: 1.0
            }
        ];
        
        // Chair properties for seated exercises
        this.chairHeight = 80;
        this.chairWidth = 120;
    }
    
    render(exercise, animTime) {
        const isSeated = exercise.type === 'seated';
        
        this.characters.forEach(char => {
            if (isSeated) {
                this.drawChair(char.x, this.height * 0.7);
            }
            this.drawCharacter(char, exercise, animTime, isSeated);
        });
    }
    
    drawChair(x, y) {
        const ctx = this.ctx;
        
        // Chair legs
        ctx.fillStyle = '#8b7355';
        ctx.fillRect(x - 50, y, 12, 80);
        ctx.fillRect(x + 38, y, 12, 80);
        ctx.fillRect(x - 50, y + 60, 12, 60);
        ctx.fillRect(x + 38, y + 60, 12, 60);
        
        // Chair seat
        ctx.fillStyle = '#a0826d';
        ctx.fillRect(x - 60, y - 10, 120, 15);
        
        // Chair back
        ctx.fillRect(x - 60, y - 100, 15, 100);
        ctx.fillRect(x - 60, y - 100, 120, 15);
    }
    
    drawCharacter(char, exercise, animTime, isSeated) {
        const ctx = this.ctx;
        const baseY = isSeated ? this.height * 0.7 - 30 : this.height * 0.75;
        
        const phase = (animTime * 2) % (Math.PI * 2);
        const anim = this.getAnimationOffsets(exercise.name, phase);
        
        const bodyX = char.x;
        const bodyY = baseY;
        
        ctx.save();
        ctx.translate(bodyX, bodyY);
        
        if (!isSeated) {
            this.drawLegs(char, anim);
        }
        this.drawTorso(char, anim, isSeated);
        this.drawArms(char, anim, exercise.name);
        this.drawHead(char, anim);
        
        ctx.restore();
    }
    
    drawLegs(char, anim) {
        const ctx = this.ctx;
        ctx.fillStyle = char.bottomColor;
        
        ctx.save();
        ctx.translate(-20, 80);
        ctx.rotate(anim.leftLegAngle || 0);
        ctx.fillRect(-15, 0, 30, 100);
        ctx.restore();
        
        ctx.save();
        ctx.translate(20, 80);
        ctx.rotate(anim.rightLegAngle || 0);
        ctx.fillRect(-15, 0, 30, 100);
        ctx.restore();
        
        ctx.fillStyle = '#2c3e50';
        ctx.fillRect(-35, 180, 30, 15);
        ctx.fillRect(5, 180, 30, 15);
    }
    
    drawTorso(char, anim, isSeated) {
        const ctx = this.ctx;
        ctx.fillStyle = char.topColor;
        
        ctx.save();
        ctx.rotate(anim.torsoRotation || 0);
        
        ctx.beginPath();
        ctx.ellipse(0, isSeated ? 20 : 40, 60, 80, 0, 0, Math.PI * 2);
        ctx.fill();
        
        ctx.strokeStyle = this.darkenColor(char.topColor, 20);
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.moveTo(-40, isSeated ? 0 : 20);
        ctx.lineTo(40, isSeated ? 0 : 20);
        ctx.stroke();
        
        ctx.restore();
        
        if (isSeated) {
            ctx.fillStyle = char.bottomColor;
            ctx.fillRect(-50, 50, 100, 60);
        }
    }
    
    drawArms(char, anim, exerciseName) {
        const ctx = this.ctx;
        const skinTone = char.skinTone;
        
        // Left arm
        ctx.save();
        ctx.translate(-50, 20);
        ctx.rotate(anim.leftArmAngle || 0);
        
        ctx.fillStyle = char.topColor;
        ctx.fillRect(-15, 0, 30, 60);
        
        ctx.fillStyle = skinTone;
        ctx.fillRect(-12, 60, 24, 50);
        
        ctx.beginPath();
        ctx.arc(0, 115, 12, 0, Math.PI * 2);
        ctx.fill();
        
        ctx.restore();
        
        // Right arm
        ctx.save();
        ctx.translate(50, 20);
        ctx.rotate(anim.rightArmAngle || 0);
        
        ctx.fillStyle = char.topColor;
        ctx.fillRect(-15, 0, 30, 60);
        
        ctx.fillStyle = skinTone;
        ctx.fillRect(-12, 60, 24, 50);
        
        ctx.beginPath();
        ctx.arc(0, 115, 12, 0, Math.PI * 2);
        ctx.fill();
        
        ctx.restore();
    }
    
    drawHead(char, anim) {
        const ctx = this.ctx;
        
        ctx.fillStyle = char.skinTone;
        ctx.fillRect(-15, -30, 30, 35);
        
        ctx.save();
        ctx.translate(0, -50);
        ctx.rotate(anim.headRotation || 0);
        
        ctx.beginPath();
        ctx.ellipse(0, 0, 40, 50, 0, 0, Math.PI * 2);
        ctx.fillStyle = char.skinTone;
        ctx.fill();
        
        this.drawHair(char);
        
        ctx.fillStyle = '#1a1a1a';
        ctx.beginPath();
        ctx.arc(-15, -5, 4, 0, Math.PI * 2);
        ctx.arc(15, -5, 4, 0, Math.PI * 2);
        ctx.fill();
        
        ctx.strokeStyle = '#8b4513';
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.arc(0, 10, 15, 0.2, Math.PI - 0.2);
        ctx.stroke();
        
        ctx.restore();
    }
    
    drawHair(char) {
        const ctx = this.ctx;
        ctx.fillStyle = char.hairColor;
        
        if (char.hairStyle === 'shoulder-length') {
            ctx.beginPath();
            ctx.ellipse(0, -10, 45, 55, 0, 0, Math.PI * 2);
            ctx.fill();
            
            ctx.fillRect(-45, 10, 20, 60);
            ctx.fillRect(25, 10, 20, 60);
        } else if (char.hairStyle === 'pulled-back') {
            ctx.beginPath();
            ctx.ellipse(0, -15, 42, 50, 0, 0, Math.PI);
            ctx.fill();
            
            ctx.beginPath();
            ctx.arc(0, -45, 20, 0, Math.PI * 2);
            ctx.fill();
        } else if (char.hairStyle === 'styled-up') {
            ctx.beginPath();
            ctx.ellipse(0, -20, 43, 48, 0, 0, Math.PI * 2);
            ctx.fill();
            
            ctx.beginPath();
            ctx.arc(0, -50, 25, 0, Math.PI * 2);
            ctx.fill();
        }
    }
    
    getAnimationOffsets(exerciseName, phase) {
        const sin = Math.sin(phase);
        const cos = Math.cos(phase);
        
        switch (exerciseName) {
            case "Seated Neck Rolls":
                return {
                    headRotation: sin * 0.3,
                    leftArmAngle: 0.1,
                    rightArmAngle: -0.1,
                    torsoRotation: 0
                };
            
            case "Seated Shoulder Shrugs":
                return {
                    headRotation: 0,
                    leftArmAngle: -0.2 + sin * 0.3,
                    rightArmAngle: 0.2 + sin * 0.3,
                    torsoRotation: sin * 0.05
                };
            
            case "Standing Side Bends":
                return {
                    headRotation: sin * 0.2,
                    leftArmAngle: -Math.PI / 2 + sin * 0.4,
                    rightArmAngle: -Math.PI / 2 - sin * 0.4,
                    torsoRotation: sin * 0.3,
                    leftLegAngle: 0,
                    rightLegAngle: 0
                };
            
            case "Seated Torso Twists":
                return {
                    headRotation: sin * 0.3,
                    leftArmAngle: -Math.PI / 3 + sin * 0.3,
                    rightArmAngle: Math.PI / 3 - sin * 0.3,
                    torsoRotation: sin * 0.4
                };
            
            case "Standing Arm Circles":
                return {
                    headRotation: 0,
                    leftArmAngle: -Math.PI / 2 + phase,
                    rightArmAngle: -Math.PI / 2 + phase + Math.PI,
                    torsoRotation: 0,
                    leftLegAngle: 0,
                    rightLegAngle: 0
                };
            
            case "Seated Wrist Rotations":
                return {
                    headRotation: 0,
                    leftArmAngle: Math.PI / 4,
                    rightArmAngle: -Math.PI / 4,
                    torsoRotation: 0
                };
            
            case "Standing Hip Circles":
                return {
                    headRotation: sin * 0.1,
                    leftArmAngle: -0.3,
                    rightArmAngle: 0.3,
                    torsoRotation: cos * 0.2,
                    leftLegAngle: sin * 0.1,
                    rightLegAngle: -sin * 0.1
                };
            
            case "Seated Ankle Rolls":
                return {
                    headRotation: 0,
                    leftArmAngle: 0.2,
                    rightArmAngle: -0.2,
                    torsoRotation: 0
                };
            
            default:
                return {
                    headRotation: 0,
                    leftArmAngle: 0,
                    rightArmAngle: 0,
                    torsoRotation: 0,
                    leftLegAngle: 0,
                    rightLegAngle: 0
                };
        }
    }
    
    darkenColor(color, percent) {
        const num = parseInt(color.replace("#", ""), 16);
        const amt = Math.round(2.55 * percent);
        const R = (num >> 16) - amt;
        const G = (num >> 8 & 0x00FF) - amt;
        const B = (num & 0x0000FF) - amt;
        return "#" + (0x1000000 + (R < 255 ? R < 1 ? 0 : R : 255) * 0x10000 +
            (G < 255 ? G < 1 ? 0 : G : 255) * 0x100 +
            (B < 255 ? B < 1 ? 0 : B : 255))
            .toString(16).slice(1);
    }
}


